{
  "manifest_version": 3,
  "name": "TermsRadar",
  "version": "1.0.0",
  "description": "Autonomous Trust Shield & Legal Agreement Risk Analyzer powered by AI & Security APIs.",
  "permissions": [
    "tabs",
    "activeTab",
    "downloads",
    "storage",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.workers.dev/*",
    "https://termsradar.arpanhait2006.workers.dev/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ui-helpers.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TermsRadar Security Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}