{
  "manifest_version": 3,
  "name": "TermsRadar",
  "version": "1.0.0",
  "description": "Autonomous Trust Shield & Legal Agreement Risk Analyzer powered by AI & Security APIs.",
  "permissions": [
    "tabs",
    "activeTab",
    "downloads",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.workers.dev/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ui-helpers.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TermsRadar Security Dashboard"
  }
}
